{
  "name": "pocketbench",
  "version": "0.3.0-alpha.1",
  "private": true,
  "type": "module",
  "description": "Local-first cross-platform file, data, image, text and AI upscaling toolbox",
  "scripts": {
    "dev": "vite --config vite.config.mjs",
    "test": "vitest run --config vitest.config.mjs",
    "test:watch": "vitest --config vitest.config.mjs",
    "test:e2e": "playwright test",
    "check": "node scripts/check.mjs",
    "build": "vite build --config vite.config.mjs && node scripts/postbuild.mjs",
    "preview": "vite preview --config vite.config.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "yaml": "2.9.1",
    "onnxruntime-web": "1.30.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
